# Django
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=generate-a-long-random-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL
POSTGRES_DB=broiler_cage
POSTGRES_USER=broiler
# Generate an alphanumeric password and place the identical value in DATABASE_URL below.
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://broiler:change-this-database-password@db:5432/broiler_cage

# Redis
REDIS_URL=redis://redis:6379/0

# HiveMQ Cloud
MQTT_HOST=replace-with-your-hivemq-cluster-host
MQTT_PORT=8883
MQTT_USERNAME=replace-with-backend-username
MQTT_PASSWORD=replace-with-backend-password
MQTT_TOPIC_PREFIX=farm/farm01/cage/cage01
MQTT_KEEPALIVE=60

# MQTT simulator - use a separate HiveMQ credential where possible
MQTT_SIMULATOR_USERNAME=replace-with-simulator-username
MQTT_SIMULATOR_PASSWORD=replace-with-simulator-password
SIMULATOR_FARM_ID=farm01
SIMULATOR_CAGE_ID=cage01
SIMULATOR_INTERVAL_SECONDS=5
SIMULATOR_HEARTBEAT_SECONDS=30
SIMULATOR_MOTION_PROBABILITY=0.01
SIMULATOR_BUZZER_HOLD_SECONDS=10
SIMULATOR_FULL_SENSOR_SET=true
