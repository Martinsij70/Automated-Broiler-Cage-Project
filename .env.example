# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://broiler:replace-with-a-strong-password@db:5432/broiler_cage
POSTGRES_DB=broiler_cage
POSTGRES_USER=broiler
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# HiveMQ Cloud
MQTT_HOST=replace-with-your-hivemq-cluster-host
MQTT_PORT=8883
MQTT_USERNAME=replace-with-backend-username
MQTT_PASSWORD=replace-with-backend-password
MQTT_TOPIC_PREFIX=farm/farm01/cage/cage01
MQTT_KEEPALIVE=60
